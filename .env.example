# Copy to .env.local (git-ignored) and fill in. Values are baked into the bundle at
# `npm run build`, so set them before building for IIS. Client IDs are public by
# design; never put a client SECRET here - secrets belong to the ASP.NET Core API.
#
# Leave a value empty to keep that provider's simulated sign-in.

# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URIs: http://localhost:5173/auth/callback/google and https://<server>/auth/callback/google
VITE_GOOGLE_CLIENT_ID=

# X developer portal > your app > User authentication settings (OAuth 2.0, Web App).
# Callback URIs: http://127.0.0.1:5173/auth/callback/x and https://<server>/auth/callback/x
# Switch on "Request email from users". The client SECRET goes in the API's XSettings.
VITE_X_CLIENT_ID=
