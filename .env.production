# Committed (not secret). The ModelFeed API on the same IIS site:
# https://velvet.love/api, whose controllers live under /api/... -> /api/api.
VITE_API_BASE_URL=/api/api

# Google OAuth client ID ("Web application"). Public by design - it is sent to
# Google in every sign-in URL. Never put the client SECRET in any .env file.
VITE_GOOGLE_CLIENT_ID=605212062971-5pm4pahema90v3if4buk76v006h77939.apps.googleusercontent.com

# X OAuth 2.0 client ID (developer portal > your app > Keys and tokens). Public,
# like the Google one (app 2114059325195067590VelvetLove4, @VelvetLove430).
# The X client SECRET goes only in the API's appsettings.Production.json (XSettings).
VITE_X_CLIENT_ID=cTJhN282QUtGNVJocWJWUnNodjk6MTpjaQ
